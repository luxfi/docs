    "@hanzo/gui": "^8.1.1",
    "@hanzo/ui": "^8.0.111",
    "@hanzogui/lucide-icons-2": "^8.1.1",
    "esbuild": "^0.25.0",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "shiki": "^3.20.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@hanzo/docs-cli": "^1.2.5",
